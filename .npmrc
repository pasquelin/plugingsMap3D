# auto-install-peers essaie de résoudre les peerDependencies non satisfaites depuis le
# registre npm. "map3d" (peerDep de chaque package @map3d/*) n'existe QUE localement
# (root devDep "file:../map3D") — un paquet public sans rapport nommé "map3d" existe sur
# le registre npm et fait échouer la résolution (ERR_PNPM_NO_MATCHING_VERSION). Désactivé
# pour que l'install se limite aux WARN peer-dep attendues (ex. three vs 3d-tiles-renderer).
auto-install-peers=false
