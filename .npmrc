# auto-install-peers essaie de résoudre les peerDependencies non satisfaites depuis le
# registre npm. On le laisse désactivé : les peers (`@pasquelin/map3d`, react, three) sont
# fournis explicitement par les devDependencies racine, et on veut que l'install se limite
# aux WARN peer-dep attendues (ex. three vs 3d-tiles-renderer) plutôt que d'aller chercher
# des versions au petit bonheur sur le registre.
auto-install-peers=false
