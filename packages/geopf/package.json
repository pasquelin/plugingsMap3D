{
  "name": "@pasquelin/map3d-plugin-geopf",
  "version": "0.1.0",
  "description": "Plugin map3D — enrichit les bâtiments 3D au clic avec les attributs BDTOPO de la Géoplateforme IGN (WFS), via useBuildingEnrichment().",
  "type": "module",
  "license": "MIT",
  "author": "Alban Pasquelin <alban.pasquelin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasquelin/plugingsMap3D.git",
    "directory": "packages/geopf"
  },
  "homepage": "https://github.com/pasquelin/plugingsMap3D/tree/main/packages/geopf#readme",
  "bugs": "https://github.com/pasquelin/plugingsMap3D/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pasquelin/map3d": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.169.0"
  }
}
