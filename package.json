{
  "name": "plugingsmap3d",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "author": "Alban Pasquelin <alban.pasquelin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasquelin/plugingsMap3D.git"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages",
    "format": "prettier --write \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx}\"",
    "validater": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "version:plugins": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@pasquelin/map3d": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.13",
    "supercluster": "^8.0.1",
    "3d-tiles-renderer": "^0.5.2",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@types/react": "^19.0.0",
    "@types/three": "^0.169.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0",
    "typescript": "^5.5.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.3.0"
  }
}
